<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Presets can contain device-local document URIs that cannot be restored safely. -->
        <exclude domain="sharedpref" path="virtual_iors_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="virtual_iors_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
